<?xml version="1.0" encoding="utf-8"?>
<!-- The launch screen before Android 12: the ARGUS splash on its blue, until Flutter draws the same splash. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/argus_splash" />
    <item>
        <bitmap android:gravity="fill" android:src="@drawable/argus_splash" />
    </item>
</layer-list>
